{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "node ./scripts/vercel-build.mjs",
  "outputDirectory": "artifacts/kaspa-disperse/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/deploy/**"
    },
    "api/kron/token-holders/[identifier].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Accept, Content-Type, Cache-Control" }
      ]
    }
  ]
}
