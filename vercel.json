  "buildCommand": "node ./scripts/vercel-build.mjs",
  "outputDirectory": "artifacts/kaspa-disperse/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
