// RESEARCH PROTOTYPE ONLY — unaudited, do not fund on mainnet.
// Fixed five-recipient / two-batch example for a particular KRON token template.
// This is intentionally separate from the production Distro route.
contract FixedFiveDistributor(
    byte[32] tokenCovid,
    byte[32] refundPubkey,
    byte[32] recipient0, byte[32] recipient1, byte[32] recipient2,
    byte[32] recipient3, byte[32] recipient4,
    int amount0, int amount1, int amount2, int amount3, int amount4,
    int maxFeeSompi,
    int tokenPrefixLen, int tokenSuffixLen, byte[32] tokenTemplateHash,
    int initTokens, int initKas
) {
    int cursor = 0;
    int remainingTokens = initTokens;
    int remainingKas = initKas;

    struct TokenState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int amount;
        bool isMinter;
    }

    function recipientKey(int index) : byte[32] {
        byte[32] result = recipient4;
        if (index == 0) result = recipient0;
        if (index == 1) result = recipient1;
        if (index == 2) result = recipient2;
        if (index == 3) result = recipient3;
        return result;
    }

    function recipientAmount(int index) : int {
        int result = amount4;
        if (index == 0) result = amount0;
        if (index == 1) result = amount1;
        if (index == 2) result = amount2;
        if (index == 3) result = amount3;
        return result;
    }

    entry pay(TokenState[] recipientStates, TokenState tokenChange, State nextState) {
        require(this.activeInputIndex == 0);
        require(tx.inputs.length == 2);
        require(cursor == 0 || cursor == 3);
        require(amount0 > 0 && amount1 > 0 && amount2 > 0 && amount3 > 0 && amount4 > 0);
        require(maxFeeSompi >= 0);
        require(remainingKas == tx.inputs[0].value);
        require(remainingTokens > 0);

        byte[32] distributorId = OpInputCovenantId(0);
        require(distributorId != tokenCovid);
        require(OpCovInputCount(distributorId) == 1);
        require(OpCovInputCount(tokenCovid) == 1);
        require(OpCovInputIdx(tokenCovid, 0) == 1);

        TokenState priorToken = readInputStateWithTemplate(
            1, tokenPrefixLen, tokenSuffixLen, tokenTemplateHash
        );
        require(priorToken.ownerIdentifier == distributorId);
        require(priorToken.identifierType == 0x02);
        require(!priorToken.isMinter);
        require(priorToken.amount == remainingTokens);
        require(tx.inputs[1].value == 50000000);

        int count = 3;
        if (cursor == 3) count = 2;
        require(recipientStates.length == count);
        int tokenOutputCount = count;
        if (cursor == 0) tokenOutputCount = tokenOutputCount + 1;
        int outputCount = tokenOutputCount + 1;
        require(tx.outputs.length == outputCount);
        require(OpCovOutputCount(tokenCovid) == tokenOutputCount);
        int paid = 0;
        for (i, 0, count, 3) {
            int index = cursor + i;
            TokenState recipient = recipientStates[i];
            // Mode 3 is KRON's wallet-address-presence ownership mode.
            require(recipient.ownerIdentifier == recipientKey(index));
            require(recipient.identifierType == 0x03);
            require(recipient.amount == recipientAmount(index));
            require(!recipient.isMinter);
            require(OpCovOutputIdx(tokenCovid, i) == i);
            require(tx.outputs[i].value == 50000000);
            validateOutputStateWithInputTemplate(
                i, recipient, 1, tokenPrefixLen, tokenSuffixLen, tokenTemplateHash
            );
            paid = paid + recipient.amount;
        }
        require(paid <= remainingTokens);
        int rest = remainingTokens - paid;

        if (cursor == 0) {
            require(rest == amount3 + amount4);
            require(OpCovOutputIdx(tokenCovid, 3) == 3);
            require(tokenChange.ownerIdentifier == distributorId);
            require(tokenChange.identifierType == 0x02);
            require(tokenChange.amount == rest);
            require(!tokenChange.isMinter);
            require(tx.outputs[3].value == 50000000);
            validateOutputStateWithInputTemplate(
                3, tokenChange, 1, tokenPrefixLen, tokenSuffixLen, tokenTemplateHash
            );
            require(OpCovOutputCount(distributorId) == 1);
            require(OpCovOutputIdx(distributorId, 0) == 4);
            require(nextState.cursor == 3);
            require(nextState.remainingTokens == rest);
            require(nextState.remainingKas == tx.outputs[4].value);
            validateOutputState(4, nextState);
        } else {
            require(rest == 0);
            require(OpCovOutputCount(distributorId) == 0);
            require(tx.outputs[2].scriptPubKey == byte[](new ScriptPubKeyP2PK(pubkey(refundPubkey))));
            // No distributor successor: all unspent KAS is refunded in this tx.
        }

        int totalOut = 0;
        for (j, 0, outputCount, 5) {
            totalOut = totalOut + tx.outputs[j].value;
        }
        int fee = tx.inputs[0].value + tx.inputs[1].value - totalOut;
        require(fee >= 0 && fee <= maxFeeSompi);
    }
}