# KasDistro + KasVolume (one repo)

Copy to a local env file or set in Vercel. Do not commit secrets.

# --- Required: API (artifacts/api-server) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kasdistro
SESSION_SECRET=generate-with-openssl-rand-base64-48
PORT=5000
NODE_ENV=development

# --- Optional: server-owned CLI / file automation only ---
# Not needed for wallet connect or user-console trading — users enter token ID in the UI.
# KASPA_BOT_PRIVATE_KEY=
# KRON_TOKEN_ID=bed3c81787e07988c6d5792fb02324bfd11b980a123f87a28eb177eeec6084a0

# --- Optional: API when UI and API are on different origins ---
# CORS_ORIGIN=https://your-frontend.vercel.app
# COOKIE_SAME_SITE=none

# --- Required: UI (Vite kaspa-disperse) ---
# PORT=5173
# BASE_PATH=/

# Leave unset for same-origin /api (Vite proxy locally, Vercel rewrite in production).
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
